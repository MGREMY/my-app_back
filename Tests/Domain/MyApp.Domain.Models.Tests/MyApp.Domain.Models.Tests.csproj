<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <!-- Design-time services (compile included) to run SqlScriptMigrationsGenerator like the EF Core tools -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Src\Domain\MyApp.Domain.Models\MyApp.Domain.Models.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Scripts of the test migrations (TestMigrations/), embedded exactly like in MyApp.Domain.Models:
            SqlScriptMigration reads them from the assembly of the migration, i.e. this test assembly.
            Every file is embedded (not only *.sql) to check that other files are ignored.
        -->
        <EmbeddedResource Include="SqlScripts\**\*"
                          LogicalName="SqlScripts/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
