<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>15</LangVersion>
        <PackageId>MyApp.Service</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyApp.Domain.Specification\MyApp.Domain.Specification.csproj" />
        <ProjectReference Include="..\MyApp.Infrastructure.Specification\MyApp.Infrastructure.Specification.csproj" />
        <Using Include="Domain.Model.Model" Alias="Models"/>
        <ProjectReference Include="..\MyApp.Domain.Model\MyApp.Domain.Model.csproj" />
        <ProjectReference Include="..\MyApp.Service.Abstractions\MyApp.Service.Abstractions.csproj" />
        <ProjectReference Include="..\MyApp.Service.Generator\MyApp.Service.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resource\SharedResource.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>SharedResource.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resource\SharedResource.fr.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>SharedResource.fr.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resource\SharedResource.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>SharedResource.resx</DependentUpon>
      </Compile>
      <Compile Update="Resource\SharedResource.fr.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>SharedResource.fr.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
