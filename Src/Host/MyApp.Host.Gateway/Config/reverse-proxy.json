{
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "back",
        "Order": 1,
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "X-Forwarded": "Set",
            "For": "Set",
            "Proto": "Set",
            "Host": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api"
          }
        ]
      },
      "front": {
        "ClusterId": "front",
        "Order": 100,
        "Match": {
          "Path": "/app/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "back": {
        "Destinations": {
          "d1": {
            "Address": "http://set-by-gateway-clusters/"
          }
        }
      },
      "front": {
        "Destinations": {
          "d1": {
            "Address": "http://set-by-gateway-clusters/"
          }
        }
      }
    }
  }
}