{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "Database": {
      "ConnectionString": "Host=localhost;Port=5433;Username=postgres;Password=password;Database=myApp"
    },
    "Cache": {
      "ConnectionString": "localhost:6379,password=password"
    },
    "Auth": {
